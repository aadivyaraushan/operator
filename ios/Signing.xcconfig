// Signing defaults. Checked in; safe for the simulator with no local setup.
//
// The simulator signs ad hoc and needs neither of these. A device build needs
// a real Apple Developer team, which is per-developer and must not be checked
// in, so set it in Local.xcconfig (gitignored) instead of editing this file:
//
//     OPERATOR_DEVELOPMENT_TEAM = ABCDE12345
//
// Find the value in Xcode under Settings > Accounts > your Apple ID > Manage
// Certificates, or at developer.apple.com/account under Membership details.
//
// If Xcode reports that "app.operator.ios" is unavailable, the App ID is
// already registered to another team. Claim your own by also setting:
//
//     OPERATOR_BUNDLE_ID_PREFIX = com.yourname.operator
//
// Note that this changes the bundle identifier on the simulator too, so the
// simulator gets a second, empty install. The existing one is left untouched.

OPERATOR_BUNDLE_ID_PREFIX = app.operator
OPERATOR_DEVELOPMENT_TEAM =

#include? "Local.xcconfig"
