# Versions used to make a clean x86_64 UTM SE guest. This file has no secrets.
ALPINE_VERSION=3.22.5
GUEST_ARCH=x86_64
GUEST_DISK_SIZE=4G

# Verified locally against the pinned Alpine cloud image on 2026-09-04.
ALPINE_IMAGE_SHA512=463f44e95fca714a84d37f9725337f99f54fe4b210488848489584910d8a33afcc8d67ff89737467e099781a09c0d798309fd661ef8e7173cd31a01b47d81705
ALPINE_IMAGE_SHA512_PREFIX=463f44

# Node ships inside the checked OpenClaw runtime payload.
NODE_VERSION=22.23.2

# The release tag and short commit were observed in the feasibility proof.
OPENCLAW_VERSION=2026.9.1
OPENCLAW_GIT_COMMIT=ad6fe23
OPENCLAW_RUNTIME_ARCHIVE=operator-openclaw-runtime-2026.9.1-r7-stage-timing.tar.gz
OPENCLAW_RUNTIME_SHA512=056e63f2ed0f363e934e4a7f484f8ef4ddc47791efea856e181e22415f88e884a02ed32975f6c68c6160d3ca141afe6f54b6821a5b8e5096561e6924fa34bb90
OPENCLAW_RUNTIME_SIZE_BYTES=246353659
OPENCLAW_REQUIRED_GATEWAY_MODULE=usr/local/lib/node_modules/openclaw/dist/push-apns-http2-CcgxgbKC.js

# Node links to this bundled SQLite runtime. Provisioning proves both its exact
# runtime version and WAL behavior through the same node:sqlite API OpenClaw uses.
SQLITE_VERSION=3.53.4
