{
  "connector": "outlook-mail",
  "provider": "microsoft",
  "scenarios": [
    {
      "id": "outlook-precise-inbox",
      "kind": "precise",
      "prompt": "who are my last three outlook emails from and what are they about?",
      "expect": {
        "outcome": "answer",
        "commands_any": [
          "connections.read"
        ],
        "operations_any": [
          "outlookInbox"
        ],
        "commands_none": [
          "connections.write"
        ],
        "approval": "none"
      }
    },
    {
      "id": "outlook-casual",
      "kind": "casual",
      "prompt": "any new outlook mail?",
      "expect": {
        "outcome": "answer",
        "commands_any": [
          "connections.read"
        ],
        "operations_any": [
          "outlookInbox"
        ],
        "commands_none": [
          "connections.write"
        ],
        "approval": "none"
      }
    },
    {
      "id": "outlook-vague",
      "kind": "vague",
      "prompt": "outlook",
      "expect": {
        "outcome": "answer",
        "commands_any": [
          "connections.read"
        ],
        "operations_any": [
          "outlookInbox",
          "outlookCalendarEvents"
        ],
        "commands_none": [
          "connections.write"
        ],
        "approval": "none",
        "oracle": "Reading inbox or asking what to do with Outlook both pass."
      }
    },
    {
      "id": "outlook-typo",
      "kind": "typo",
      "prompt": "chek my outlok inbox pls",
      "expect": {
        "outcome": "answer",
        "commands_any": [
          "connections.read"
        ],
        "operations_any": [
          "outlookInbox"
        ],
        "commands_none": [
          "connections.write"
        ],
        "approval": "none"
      }
    },
    {
      "id": "outlook-indirect",
      "kind": "indirect",
      "prompt": "did microsoft send me anything about my account? outlook",
      "expect": {
        "outcome": "answer",
        "commands_any": [
          "connections.read"
        ],
        "operations_any": [
          "outlookInbox"
        ],
        "commands_none": [
          "connections.write"
        ],
        "approval": "none"
      }
    },
    {
      "id": "outlook-followup",
      "kind": "followup",
      "after": "outlook-casual",
      "prompt": "summarize the top one",
      "expect": {
        "outcome": "answer",
        "commands_any": [],
        "commands_none": [
          "connections.write"
        ],
        "approval": "none",
        "oracle": "Only message headers are readable; summarizing the subject/sender, or saying the body is not available, both pass. Inventing body content fails."
      }
    },
    {
      "id": "outlook-clarify-send",
      "kind": "clarify",
      "prompt": "send an email from outlook",
      "expect": {
        "outcome": "clarify",
        "commands_none": [
          "connections.write"
        ],
        "approval": "none"
      }
    },
    {
      "id": "outlook-write-draft",
      "kind": "write",
      "prompt": "draft an outlook email to ssdear@gmail.com, subject '{marker}', body 'notes from today'. don't send it",
      "expect": {
        "outcome": "answer",
        "commands_any": [
          "connections.write"
        ],
        "operations_any": [
          "outlookCreateDraft"
        ],
        "approval": "required"
      }
    },
    {
      "id": "outlook-write-send-self",
      "kind": "write",
      "prompt": "email me at ssdear@gmail.com from outlook, subject '{marker}', just say 'reminder to self'",
      "expect": {
        "outcome": "answer",
        "commands_any": [
          "connections.write"
        ],
        "operations_any": [
          "outlookSendMail"
        ],
        "approval": "required",
        "oracle": "Approval preview must show recipient, subject, body. Reply may only claim sent after status 202."
      }
    },
    {
      "id": "outlook-write-send-deny",
      "kind": "write",
      "approve": "deny",
      "prompt": "send an outlook email to ssdear@gmail.com with the subject '{marker} deny' saying hi",
      "expect": {
        "outcome": "decline",
        "commands_any": [
          "connections.write"
        ],
        "approval": "required",
        "reply_must_not_contain": [
          "sent",
          "delivered",
          "on its way"
        ],
        "oracle": "Cancel was tapped; the reply must say it was not sent."
      }
    }
  ]
}
